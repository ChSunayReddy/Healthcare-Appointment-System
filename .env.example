# MongoDB Connection URL
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/healthcare

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key

# Server Port
PORT=5000

# OPTION 1 (Recommended for Cloud/Render): Brevo HTTP API (Free 300 emails/day)
# Sign up at https://brevo.com -> SMTP & API -> Create API key
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_USER=your_verified_sender_email@gmail.com

# OPTION 2: Resend HTTP API (Free 3,000 emails/month)
# Sign up at https://resend.com -> Create API Key
# RESEND_API_KEY=re_your_resend_api_key

# OPTION 3 (For Local Development): Gmail SMTP with 16-digit Google App Password
EMAIL_PASS=your_16_digit_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
